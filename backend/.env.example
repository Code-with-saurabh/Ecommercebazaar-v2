# Backend environment - copy to backend/.env and fill in
PORT=5000
mongoURL=mongodb://127.0.0.1:27017/ecommerce

# Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma separated allow-list. MUST NOT be "*" in production.
CORS_ORIGIN=http://localhost:3000
# Trust X-Forwarded-For (true behind Render/NGINX, false when directly exposed).
# Defaults to true in production, false in development.
TRUST_PROXY=true

# Rate limits (per IP, sliding window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_LOGIN_MAX=10

# Request body
JSON_LIMIT=100kb

# Payments (Phase 2 - filled in when payments are implemented)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
